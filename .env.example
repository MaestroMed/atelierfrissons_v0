# ─────────────────────────────────────────────────────────────────
# Atelier Frisson — variables d'environnement (exemple)
# Copier ce fichier en `.env.local` (dev) ou configurer sur Vercel (prod)
# ─────────────────────────────────────────────────────────────────

# ── Next.js
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME="Atelier Frisson"

# ── Supabase (région EU : Paris ou Frankfurt)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

# ── Stripe (DEV UNIQUEMENT — compte banni si paiement réel en secteur adulte)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ── CCBill (PROD — activé après K-Bis SASU + onboarding 2-5 sem)
CCBILL_ACCOUNT_ID=
CCBILL_SUB_ACCOUNT=
CCBILL_SALT=
CCBILL_WEBHOOK_SECRET=
CCBILL_FLEXFORM_ID=

# ── CJdropshipping (entrepôt Pologne CJPL prioritaire)
CJ_API_URL=https://developers.cjdropshipping.com
CJ_API_EMAIL=
CJ_API_KEY=
CJ_WAREHOUSE_CODE=CJPL

# ── Resend (emails transactionnels)
RESEND_API_KEY=
RESEND_FROM_EMAIL=contact@atelierfrisson.fr
RESEND_WEBHOOK_SECRET=

# ── Klaviyo (emails marketing, flows, abandonment)
KLAVIYO_PUBLIC_KEY=
KLAVIYO_PRIVATE_KEY=

# ── Mux (vidéo HLS adaptatif)
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=
MUX_WEBHOOK_SECRET=
MUX_SIGNING_KEY_ID=
MUX_SIGNING_KEY_PRIVATE=

# ── Age verification (Arcom — double anonymat)
VERIFYMY_API_KEY=
VERIFYMY_MERCHANT_ID=
VERIFYMY_WEBHOOK_SECRET=

# ── Upstash Redis (rate limiting, sessions)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Sentry (errors + performance)
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# ── PostHog (analytics, heatmaps, funnels)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.posthog.com

# ── MeiliSearch (self-hosted) ou Algolia
MEILI_HOST=
MEILI_API_KEY=
MEILI_INDEX_PREFIX=af_

# ── FORJA (factory pSEO Numelite)
FORGE_INGEST_SECRET=
FORGE_WEBHOOK_SECRET=

# ── Admin (bootstrap 2FA)
ADMIN_BOOTSTRAP_EMAIL=
